# Copy to .env and fill in real values. Never commit .env.

# ---- General ----
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag
POSTGRES_PASSWORD=legal_rag

# ---- Redis (optional) ----
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS_CACHE=false

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=legal_chunks
ELASTICSEARCH_ENABLED=true

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
GRAPH_RAG_ENABLED=true

# ---- Embeddings ----
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu

# ---- Reranker ----
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# ---- LLM (Gemini via OpenAI-compatible endpoint) ----
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-api-key-here
# Optional generic alias. If set, LLM_API_KEY takes precedence over GEMINI_API_KEY.
LLM_API_KEY=
LLM_MODEL_NAME=gemini-3.5-flash
LLM_TEMPERATURE=0.0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
